rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function myRole() {
      return userDoc(request.auth.uid).data.role;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdminTier() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (myRole() in ['Admin', 'Head', 'Developer']);
    }

    function isLeadForSubject(subject) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (myRole() == subject + ' Lead');
    }

    function isSchoolEmail(email) {
      return email is string
        && email.size() <= 254
        && email.lower().matches('.*@(hwemail|hw)\\.com');
    }

    // --- users/{uid} -------------------------------------------------------
    // Only admins may set `role` or `classes`. A user creating/updating their
    // own doc may leave them absent, keep them unchanged, or (on first write)
    // set role to the default "student" / classes to an empty list.
    function selfRoleOk() {
      return !('role' in request.resource.data)
        || request.resource.data.role == 'student'
        || (resource != null && 'role' in resource.data
            && request.resource.data.role == resource.data.role);
    }

    function selfClassesOk() {
      return !('classes' in request.resource.data)
        || (request.resource.data.classes is list && request.resource.data.classes.size() == 0)
        || (resource != null && 'classes' in resource.data
            && request.resource.data.classes == resource.data.classes);
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdminTier();

      allow create: if isSelf(uid) && selfRoleOk() && selfClassesOk();
      allow update: if isSelf(uid) && selfRoleOk() && selfClassesOk();

      // Elevated can write anything (admin console, tools)
      allow write: if isAdminTier();
    }

    // --- ClassRequests/{requestId} ----------------------------------------
    // Tutor class approval requests
    match /ClassRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        isAdminTier() ||
        isLeadForSubject(resource.data.subject)
      );

      // Create by owner only, always pending
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.subject is string
        && request.resource.data.class is string;

      // Status moderation by admin tier or the lead for that subject
      allow update: if isSignedIn() && (
        isAdminTier() ||
        isLeadForSubject(resource.data.subject)
      );

      allow delete: if isAdminTier();
    }

    // --- Requests/{docId} (student tutoring requests) ----------------------
    // Students do not have accounts, so anyone may create a request, but it
    // must look like a real request. Signed-in tutors may update/delete
    // (finalize, cancel & reopen).
    match /Requests/{docId} {
      allow read: if isSignedIn();
      allow create: if isSchoolEmail(request.resource.data.email)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.subject is string
        && request.resource.data.class is string
        && request.resource.data.availability is list
        && request.resource.data.availability.size() > 0
        && request.resource.data.availability.size() <= 50
        && (!('topic' in request.resource.data) || request.resource.data.topic == null || request.resource.data.topic.size() <= 500)
        && (!('info' in request.resource.data) || request.resource.data.info == null || request.resource.data.info.size() <= 1000)
        && (!('location' in request.resource.data) || request.resource.data.location == null || request.resource.data.location.size() <= 200);
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // --- Sessions/{sessionId} ---------------------------------------------
    match /Sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // --- Hours/{hourId} ----------------------------------------------------
    match /Hours/{hourId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.tutorUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        resource.data.tutorUid == request.auth.uid ||
        isAdminTier()
      );
    }

    // --- cycleDays/{dateId} (cached school calendar) -----------------------
    // Read by anyone (the public request form needs it); written by admins.
    match /cycleDays/{dateId} {
      allow read: if true;
      allow write: if isAdminTier();
    }

    // --- PasswordResetThrottle/{email} (reset email cooldown) --------------
    // Written only by the sendPasswordReset function through the Admin SDK,
    // which bypasses these rules. No client may read or write it; a readable
    // cooldown record would leak which addresses have accounts.
    match /PasswordResetThrottle/{email} {
      allow read: if false;
      allow write: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
